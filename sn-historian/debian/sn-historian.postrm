#!/bin/sh
set -e

if [ "$1" = "remove" ]; then
	systemctl daemon-reload >/dev/null || true
fi

# Purge keeps the history data and the admin's /etc/default/sn-historian. Only
# sn-historian's own state goes: /var/lib/sn-historian also holds
# sn-historian-db-local's markers, which it still needs if it is installed again.
if [ "$1" = "purge" ]; then
	rm -f /var/lib/sn-historian/jar-loaded /var/lib/sn-historian/jar-loaded.tmp \
		/var/lib/sn-historian/pool-bound
	rmdir /var/lib/sn-historian 2>/dev/null || true
	# a restart that is still waiting (requested by the removal) needs its request file
	case "$(systemctl show -p ActiveState --value sn-historian-restart-solarnode.service 2>/dev/null)" in
		active|activating|deactivating) ;;
		*) rm -rf /run/sn-historian ;;
	esac
fi
