#!/bin/sh
set -e

CONF="/usr/share/solarnode/default/solarnode-bluetooth-setup"
VENDOR_CONF="/etc/default/solarnode-bluetooth-setup"

if [ -e "$CONF" ]; then
	. "$CONF"
fi
if [ -e "$VENDOR_CONF" ]; then
	. "$VENDOR_CONF"
fi

service_up () {
	name="$1"
	start="$2"
	if ! systemctl is-enabled "$name" >/dev/null; then
		echo "Enabling $name..."
		systemctl enable "$name" || true
	fi
	if [ -n "$start" ]; then
		if ! systemctl is-active "$name" >/dev/null; then
			systemctl start "$name" || true
		else
			systemctl restart "$name" || true
		fi
	fi
}

BLUETOOTH_CONF="/etc/bluetooth/main.conf"
if grep -q '^DiscoverableTimeout = 0' $BLUETOOTH_CONF; then
	true
else
	echo "Setting DiscoverableTimeout = 0 in $BLUETOOTH_CONF."
	if grep -q 'DiscoverableTimeout[[:space:]]*=' $BLUETOOTH_CONF; then
		# update
		sed -i -e '/DiscoverableTimeout[[:space:]]*=/c DiscoverableTimeout = 0' $BLUETOOTH_CONF || true
	else
		# add in
		echo 'DiscoverableTimeout = 0' >>$BLUETOOTH_CONF
	fi
fi
if grep -q '^AutoEnable[[:space:]]*=[[:space:]]*true' $BLUETOOTH_CONF; then
	true
else
	echo "Setting AutoEnable = true in $BLUETOOTH_CONF."
	if grep -q 'AutoEnable[[:space:]]*=' $BLUETOOTH_CONF; then
		# update
		sed -i -e '/AutoEnable[[:space:]]*=/c AutoEnable = true' $BLUETOOTH_CONF || true
	else
		# add in
		echo 'AutoEnable = true' >>$BLUETOOTH_CONF
	fi
fi

setup_user_conf_example='/usr/share/solarnode/example/solarnode-bluetooth-setup-user.csv'
setup_user_conf='/etc/solarnode/auto-settings.d/solarnode-bluetooth-setup.csv'
if [ -z "$CFG_WITHOUT_SETUP_USER" -a ! -e "${setup_user_conf}" ]; then
	if [ -e "${setup_user_conf_example}" ]; then
		echo "Creating default setup user configuration ${setup_user_conf}"
		if [ ! -d "${setup_user_conf%/*}" ]; then
			mkdir -p "${setup_user_conf%/*}"
		fi
		cp "${setup_user_conf_example}" "${setup_user_conf}"
	fi
fi

systemctl daemon-reload || true
service_up solarnode-bt-setup-peripheral-restart.path true

# The peripheral is enabled and started by default. CFG_BT_SETUP_GATED=1 leaves
# it disabled so the SolarNode plugin controls it. The plugin's last
# enable/disable sets the unit's boot state, so upgrades from 4.0.0 or later
# ($2 is the previous version) keep that state.
if [ "$CFG_BT_SETUP_GATED" = "1" ]; then
	echo "Leaving solarnode-bt-setup-peripheral disabled (radio is gated)..."
	systemctl disable solarnode-bt-setup-peripheral 2>/dev/null || true
	/usr/share/solarnode/cfg.d/bluetooth.sh disable || true
elif [ -z "$2" ] || dpkg --compare-versions "$2" lt 4.0.0 \
		|| systemctl is-enabled --quiet solarnode-bt-setup-peripheral 2>/dev/null; then
	service_up solarnode-bt-setup-peripheral true
else
	echo "Leaving solarnode-bt-setup-peripheral disabled (turned off by the SolarNode plugin)..."
fi
