# Enabled at install (the radio is always on by default). The SolarNode plugin
# may enable/disable it with `solarcfg bluetooth enable|disable` when gating is
# configured; both also set the boot state.

[Unit]
Description=SolarNode Bluetooth Setup peripheral
After=bluetooth.service
PartOf=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/solarnode/bluetooth-setup.env
ExecStart=/usr/bin/python3 /usr/share/solarnode/bin/sn-bt-setup-peripheral.py
# on-failure, not always: the peripheral exits 0 when the node has no ID yet
# (nothing to advertise)
Restart=on-failure
RestartSec=10

[Install]
WantedBy=bluetooth.target
